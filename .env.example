# Copy this file to .env and fill in values. .env is git-ignored.

# Optional: NewsAPI (https://newsapi.org) — free dev tier, verify terms before use.
NEWSAPI_KEY=

# Optional: FRED API (https://fred.stlouisfed.org/docs/api/api_key.html) — free, instant signup.
FRED_API_KEY=

# No key required for: GDELT DOC 2.0 API, yfinance, US Treasury daily par yield XML.
